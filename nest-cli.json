{
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.json"
      }
    },
    "case-explorer": {
      "type": "application",
      "root": "apps/case-explorer",
      "entryFile": "main",
      "sourceRoot": "apps/case-explorer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/case-explorer/tsconfig.json"
      }
    },
    "api-grpc": {
      "type": "application",
      "root": "apps/api-grpc",
      "entryFile": "main",
      "sourceRoot": "apps/api-grpc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-grpc/tsconfig.json"
      }
    }
  }
}
